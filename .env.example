# Neon Postgres (pulled automatically via `neon deploy`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js (Google OAuth + Credentials)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin access (comma-separated emails and/or bootstrap credentials)
ADMIN_EMAILS=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe (Donations + Store)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email SMTP (optional - logs preview in dev if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vivências Superdotadas <contato@vivenciassuperdotadas.org>"

NEXT_PUBLIC_SITE_URL=https://vivenciassuperdotadas.vercel.app
